{
  "expo": {
    "name": "Zenith Productivity Hub",
    "slug": "zenith-productivity-hub",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.zenith-productivity-hub",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to use your location.",
        "NSLocationAlwaysUsageDescription": "Allow $(PRODUCT_NAME) to use your location.",
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to use your location.",
        "UIBackgroundModes": [
          "location",
          "location"
        ]
      },
      "usesIcloudStorage": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.zenith_productivity_hub",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./local/assets/notification_icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": [
            "./local/assets/notification_sound.wav"
          ],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BudgetWidget",
              "label": "Budget Overview",
              "description": "Shows your current month income, expenses, and net cashflow",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "TasksWidget",
              "label": "Tasks Today",
              "description": "Shows today's tasks with priority, time, and overdue indicators",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "200dp",
              "targetCellWidth": 3,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "HabitsWidget",
              "label": "Habits Today",
              "description": "Shows each habit with completion status, streak, and overall percentage",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "200dp",
              "targetCellWidth": 3,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "CalendarWidget",
              "label": "Calendar Agenda",
              "description": "Shows today's event count and next upcoming event",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "NotesWidget",
              "label": "Notes Overview",
              "description": "Shows total notes, pinned count, and latest note",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "PrioritiesWidget",
              "label": "Top Priorities",
              "description": "Shows today's priorities with subtask progress and overdue indicators",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "200dp",
              "targetCellWidth": 3,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "GiftsWidget",
              "label": "Gift Tracker",
              "description": "Shows gift progress and next upcoming event",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "BingoWidget",
              "label": "2026 Bingo Goals",
              "description": "Shows the full 5x5 bingo card with goal completion status",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "220dp",
              "minHeight": "260dp",
              "targetCellWidth": 4,
              "targetCellHeight": 5,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "LockScreenPrioritiesWidget",
              "label": "Lock Screen Priorities",
              "description": "Compact top-5 priority list for the Samsung lock screen widget panel",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "BrainDumpWidget",
              "label": "Brain Dump",
              "description": "One-tap launcher to clear your head — shows last dump stats and a quick open button",
              "previewImage": "./assets/images/adaptive-icon.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://rork.com/"
      },
      "eas": {
        "projectId": "77c66818-6cce-42dc-a955-b6a602314ca9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/77c66818-6cce-42dc-a955-b6a602314ca9"
    }
  }
}
